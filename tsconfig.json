{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@checkout/contracts": ["./packages/contracts/src/index.ts"],
      "@checkout/domain": ["./packages/domain/src/index.ts"]
    }
  },
  "include": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
