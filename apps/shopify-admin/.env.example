# Copy to .env. Shopify CLI supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET, and SHOPIFY_APP_URL.
# Runtime app (pnpm/npm run dev) uses MONGODB_URI + MONGODB_DATABASE only.
MONGODB_URI=mongodb://127.0.0.1:27027
MONGODB_DATABASE=checkout_development
# Live checkout sessions and rate limits. Required in production (checkout returns 503 without it).
# Local dev: `redis-server` then redis://127.0.0.1:6379. Unset in dev = in-memory fallback.
REDIS_URL=
# Checkout session lifetime (seconds, min 60). Default 1800.
# CHECKOUT_SESSION_TTL_SECONDS=1800
# Own proxies (load balancer, tunnel) between Shopify and this app; used to find the shopper IP
# in X-Forwarded-For for rate limiting. Default 0 = last entry.
# TRUSTED_PROXY_HOPS=0
# Per-IP limit overrides as requests/windowSeconds, e.g. RATE_LIMIT_PLACE_ORDER=5/60.
# Groups: SESSION_CREATE SESSION_READ SESSION_WRITE PLACE_ORDER OTP_REQUEST OTP_VERIFY CUSTOMER
# MONGODB_TEST_URI is NOT used by the app. It is only for `pnpm test:admin:db`, e.g.:
# MONGODB_TEST_URI=mongodb://127.0.0.1:27027 pnpm test:admin:db
# Those tests create temporary DBs named checkout_test_<uuid> and drop them afterward.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable across restarts; changing it makes existing sessions unreadable.
SESSION_ENCRYPTION_KEY=
# While `pnpm dev` is running, theme app embeds only appear on the CLI host theme.
# Copy the numeric id from: "Setup your theme app extension in the host theme"
# https://.../admin/themes/<THIS_ID>/editor
SHOPIFY_THEME_EXTENSION_HOST_THEME_ID=
