# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/checkout-admin
MONGODB_DATABASE=checkout-admin

# Authentication & JWT
JWT_SECRET=tezvix-dashboard-backend-jwt-secret-key-2026!
JWT_EXPIRES_IN=24h

# Initial Super Admin Seed (created automatically if 0 users exist)
INITIAL_ADMIN_EMAIL=admin@tezvix.internal
INITIAL_ADMIN_PASSWORD=Admin@123456

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

